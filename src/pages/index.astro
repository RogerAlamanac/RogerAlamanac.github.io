  <style is:global>
    :root{--bg:#10120f;--panel:#181b17;--ink:#f2f1e9;--muted:#a1a69a;--lime:#c9f36a;--line:#30352d;--mono:'DM Mono',monospace;--sans:'Space Grotesk',sans-serif}
