    header{position:sticky;top:0;z-index:10;background:rgba(16,18,15,.88);backdrop-filter:blur(14px);border-bottom:1px solid rgba(255,255,255,.06)}.nav{height:76px;display:flex;align-items:center;justify-content:space-between}.brand{font-weight:700;letter-spacing:-.04em;font-size:1rem}.brand span{color:var(--lime)}.nav-links{display:flex;align-items:center;gap:30px;color:#c4c8bc}.nav-links a:hover{color:var(--lime)}.nav-cta{border:1px solid var(--line);padding:10px 14px;color:var(--lime)}.language-picker select{appearance:none;background:#181b17;color:var(--lime);border:1px solid var(--line);padding:9px 28px 9px 10px;font-family:var(--mono);font-size:.68rem;letter-spacing:.07em;text-transform:uppercase;cursor:pointer}.language-picker{position:relative}.language-picker:after{content:'⌄';position:absolute;right:9px;top:5px;color:var(--lime);pointer-events:none;font-size:1rem}.language-picker select:focus-visible{outline:2px solid var(--lime);outline-offset:3px}
    .hero{padding:105px 0 100px;position:relative;overflow:hidden}.hero:after{content:'RA';position:absolute;font-weight:700;font-size:clamp(17rem,36vw,34rem);line-height:.8;letter-spacing:-.12em;color:rgba(201,243,106,.035);right:-.02em;top:70px;pointer-events:none}.hero-inner{position:relative;z-index:1;max-width:850px}.hero h1{font-size:clamp(3.7rem,9vw,7.7rem);letter-spacing:-.085em;line-height:.91;margin:25px 0 28px}.hero h1 em{font-style:normal;color:var(--lime)}.hero-copy{font-size:1.12rem;color:#b8bdb1;max-width:570px}.hero-actions{display:flex;gap:14px;margin-top:34px;flex-wrap:wrap}.button{display:inline-flex;align-items:center;gap:12px;padding:14px 18px;border:1px solid var(--line);transition:.2s}.button.primary{background:var(--lime);color:#171a12;border-color:var(--lime);font-weight:500}.button:hover{transform:translateY(-2px);border-color:var(--lime)}.arrow{font-size:1.1rem}
    .hero-title-row{display:flex;align-items:center;gap:clamp(20px,4vw,42px)}.hero-portrait{width:clamp(112px,18vw,178px);aspect-ratio:1;flex:0 0 auto;object-fit:cover;object-position:center 38%;border:2px solid #71864b;border-radius:50%;box-shadow:0 0 0 9px #c9f36a0c}
    .stats{display:grid;grid-template-columns:.65fr 3fr;gap:22px;margin-top:64px;padding-top:24px;border-top:1px solid var(--line);max-width:760px}.stat strong{display:block;font-size:clamp(.95rem,1.5vw,1.25rem);line-height:1.15}.stat small{color:var(--muted);font-family:var(--mono);font-size:.66rem;text-transform:uppercase;letter-spacing:.06em}.skill-stat>small{display:block;margin-top:8px}.skill-titles{display:flex;align-items:center;gap:24px;flex-wrap:wrap}.skill-titles strong{font-size:clamp(.95rem,1.5vw,1.25rem)}
    section{padding:88px 0}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:30px;gap:20px}.section-head h2{font-size:clamp(2.3rem,5vw,4rem);letter-spacing:-.07em;line-height:1;margin:13px 0 0}.section-note{font-family:var(--mono);font-size:.72rem;color:var(--muted);text-transform:uppercase;letter-spacing:.07em}
    .projects{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}.project{background:var(--panel);border:1px solid var(--line);overflow:hidden;transition:transform .25s,border-color .25s}.project:hover{transform:translateY(-5px);border-color:#58634a}.cover{height:270px;position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center;background:#252a20}.cover>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.cover:before,.cover:after{content:'';position:absolute;inset:0;pointer-events:none}.cover:after{background:linear-gradient(0deg,rgba(8,10,8,.45),transparent 60%)}.cover.one{background:#20271c}.cover.two{background:#292124}.cover.linfo{background:radial-gradient(ellipse at 50% 100%,#314e45,#192421 55%,#151a1a);color:#e9f0e5}.linfo-mark{z-index:1;display:flex;flex-direction:column;align-items:center;gap:9px;text-align:center}.linfo-mark span,.linfo-mark small{font-family:var(--mono);font-size:.65rem;letter-spacing:.2em;color:#b5d5bb}.linfo-mark strong{font-size:clamp(3.3rem,8vw,5.2rem);letter-spacing:.12em;line-height:1;text-shadow:0 5px 28px #0008}.linfo-mark strong span{font:inherit;color:var(--lime);letter-spacing:inherit}.linfo-mark small{color:#e0e5dc}.cover-label{position:absolute;z-index:2;left:18px;top:18px}.tag{padding:7px 9px;background:#10120fc9;border:1px solid #ffffff28;color:var(--lime);font-size:.62rem}.project-body{padding:22px 23px 24px}.project-title{display:flex;justify-content:space-between;align-items:start;gap:15px}.project h3{font-size:1.45rem;letter-spacing:-.04em;margin:0}.project-year{font-family:var(--mono);font-size:.7rem;color:var(--muted);white-space:nowrap}.project p{color:#adb2a8;font-size:.91rem;margin:10px 0 20px;max-width:520px}.chips{display:flex;flex-wrap:wrap;gap:7px}.chip{border:1px solid var(--line);padding:5px 8px;color:#c5c9bd;font-family:var(--mono);font-size:.64rem}.project-link{display:inline-flex;color:var(--lime);font-family:var(--mono);font-size:.69rem;text-transform:uppercase;letter-spacing:.06em;margin-top:20px;gap:9px}
    .about-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:70px;align-items:start}.about-card{border:1px solid var(--line);background:linear-gradient(145deg,#1b2017,#141713);padding:28px;min-height:330px;position:relative;overflow:hidden}.about-card .avatar{width:78px;height:78px;border:1px solid #71864b;border-radius:50%;display:grid;place-items:center;color:var(--lime);font-family:var(--mono);font-size:1.15rem;margin:12px 0 25px}.about-card img.avatar{display:block;object-fit:cover}.about-card h3{font-size:1.7rem;line-height:1.1;letter-spacing:-.05em;margin:0 0 8px}.about-card p{color:var(--muted);font-size:.9rem;margin:0}.about-text p{font-size:1.07rem;color:#c1c5bb;margin:0 0 20px}.about-text p strong{color:var(--ink);font-weight:500}.skills{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:28px}.skill{border-top:1px solid var(--line);padding:12px 0;color:#c9cdc3;font-family:var(--mono);font-size:.73rem}.skill span{color:var(--lime);margin-right:8px}
    .cover.netgame{background:radial-gradient(ellipse at 50% 50%,#34495a,#1b2a32 45%,#151a1e);color:#ecf2f4}.netgame-mark{z-index:1;display:flex;flex-direction:column;align-items:center;gap:10px;text-align:center}.netgame-mark .crosshair{font-size:3.8rem;line-height:1;color:#b8e4df;text-shadow:0 0 28px #7cd4c966}.netgame-mark strong{font-size:clamp(1.5rem,4vw,2.5rem);letter-spacing:.1em;line-height:1}.netgame-mark small{font-family:var(--mono);font-size:.66rem;letter-spacing:.2em;color:#b8c9d0}
    .cover.linfo{height:auto;aspect-ratio:16/9}
    .tool-groups{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.tool-group{background:var(--panel);border:1px solid var(--line);padding:23px}.tool-group h3{font-family:var(--mono);font-size:.74rem;font-weight:400;letter-spacing:.1em;text-transform:uppercase;color:var(--lime);margin:0 0 19px}.tool-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.tool{display:flex;align-items:center;gap:12px;padding:12px;border:1px solid #ffffff0d;background:#10120f66;min-width:0}.tool-icon{width:38px;height:38px;flex:0 0 38px;display:grid;place-items:center;border-radius:9px;background:#252a21;color:#e9eee2;font-family:var(--sans);font-size:.88rem;font-weight:700;letter-spacing:-.06em}.tool-icon img{width:25px;height:25px;object-fit:contain}.tool-icon.unity{background:#f2f2ed;color:#141612}.tool-icon.unreal{background:#282b31;color:#fff}.tool-icon.jira{background:#163d7a;color:#dcebff}.tool-icon.github{background:#29272e;color:#fff}.tool-icon.github img{filter:invert(1)}.tool-icon.visualstudio{background:#32245f;color:#d8caff}.tool-icon.vscode{background:#143b55;color:#a9ddff}.tool-icon.blender{background:#543315;color:#ffbd79}.tool-icon.maya{background:#173b3e;color:#a8e0e2}.tool-icon.qa{background:#3b3620;color:#e2d18a}.tool-icon.gamedesign{background:#293c2b;color:#bde8a7}.tool-icon.prototype{background:#34304b;color:#d3c7ff}.tool-icon.trello{background:#173e62;color:#bde0ff}.tool-icon.gitkraken{background:#343047;color:#d0c7ff}.tool-icon.fork{background:#493022;color:#ffd0a8}.tool-icon.max{background:#4a361e;color:#f3d18a}.tool-name{font-size:.84rem;font-weight:600;line-height:1.2}.tool-detail{font-family:var(--mono);font-size:.59rem;color:var(--muted);margin-top:4px}
    .contact{border-top:1px solid var(--line);padding:80px 0 92px;background:radial-gradient(ellipse at 50% 100%,#29321f55,transparent 58%)}.contact-inner{display:flex;align-items:end;justify-content:space-between;gap:35px}.contact h2{font-size:clamp(3rem,7vw,6rem);letter-spacing:-.08em;line-height:.95;margin:16px 0 20px}.contact p{color:var(--muted);max-width:430px}.contact-actions{display:flex;flex-direction:column;align-items:flex-start;gap:13px}.contact-email{font-size:1.08rem;border-bottom:1px solid var(--lime);padding-bottom:5px}.socials{display:flex;gap:20px;color:#bdc2b7;font-family:var(--mono);font-size:.72rem;text-transform:uppercase}.socials a:hover{color:var(--lime)}footer{border-top:1px solid var(--line);padding:20px 0;color:#777e72;font-family:var(--mono);font-size:.65rem;text-transform:uppercase;letter-spacing:.06em}.footer-inner{display:flex;justify-content:space-between;gap:15px}
    @media(max-width:720px){.wrap{width:min(100% - 32px,560px)}.nav{height:66px}.nav-links{gap:15px}.nav-links a:not(.nav-cta){display:none}.hero{padding:77px 0 68px}.hero:after{right:-.2em;top:95px}.hero-title-row{gap:14px}.hero-portrait{width:clamp(62px,18vw,88px)}.hero h1{font-size:clamp(2.5rem,11vw,3.8rem)}.stats{grid-template-columns:1fr;gap:20px}.stat strong,.skill-titles strong{font-size:1rem}.stat small{font-size:.58rem}.skill-titles{gap:12px}section{padding:65px 0}.section-head{align-items:start;flex-direction:column}.projects{grid-template-columns:1fr}.cover{height:235px}.about-grid{grid-template-columns:1fr;gap:30px}.about-card{min-height:270px}.tool-groups{grid-template-columns:1fr}.contact-inner{align-items:start;flex-direction:column}.contact-actions{margin-top:8px}.footer-inner{flex-direction:column}.section-note{display:none}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{transition:none!important}}
  </style>
